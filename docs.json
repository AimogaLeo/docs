{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aimoga Help Center",
  "colors": {
    "primary": "#0C63ED",
    "light": "#A0D2EA",
    "dark": "#0C63ED"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "云平台",
          "href": "https://cloud-cn.aimoga-robot.com/",
          "icon": "book-open-cover"
        },
        {
          "anchor": "开发者门户",
          "href": "https://cloud-cn.aimoga-robot.com/aimoga-docs/",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/light.png",
    "dark": "/images/dark.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "官网",
      "href": "https://www.aimoga-robot.com/global/zh/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
