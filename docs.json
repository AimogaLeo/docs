{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aimoga Help Center",
  "colors": {
    "primary": "#0C63ED",
    "light": "#A0D2EA",
    "dark": "#0C63ED"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/light.png",
    "dark": "/images/dark.png"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support@aimoga-robot.com",
        "label": "邮箱"
      }
    ],
    "primary": {
      "type": "button",
      "label": "官网",
      "href": "https://www.aimoga-robot.com/global/zh/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
